# ── Virtual environments ──
venv/
.venv/
env/
.env/
ENV/

# ── Byte-compiled / cache ──
**/__pycache__/
*.py[cod]
*$py.class
*.bkp

# ── Packaging / build artifacts ──
*.egg-info/
*.egg
build/
dist/
wheels/
.installed.cfg
MANIFEST

# ── Test & lint caches ──
.pytest_cache/
.ruff_cache/
.mypy_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ── Secrets & local config ──
# AvIator writes its own config to ~/.aviator, outside the repo, but keep
# stray local env files out regardless.
.env
.env.*
!.env.example

# ── Traffic captures (real conversation content — never commit) ──
# scripts/observe.py dumps full request bodies and raw response streams so the
# wire format can be established from evidence rather than assumed. Those files
# contain live prompts, source code, and file contents from real sessions.
# Both the directory and the filename patterns are ignored, so a capture
# written to the wrong place is still caught.
captures/
*.capture.json
*.capture.jsonl
*.capture.sse

# ── Personal working docs (not repo content) ──
/BUILD-PLAN.md
/CONTEXT*

# ── Editors / OS ──
.vscode/
.idea/
*.swp
.DS_Store
